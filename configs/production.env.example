HTTP_PORT=8080
DATABASE_PATH=corvus.db
# Required: generate with `head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9'`
JWT_SECRET=
JWT_EXPIRATION=24h
LOG_LEVEL=info
ENVIRONMENT=production
# CORS_ORIGIN: comma-separated list of allowed origins (e.g. "https://example.com"), or * for all
CORS_ORIGIN=*
